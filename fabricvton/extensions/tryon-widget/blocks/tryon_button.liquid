{% comment %}
  FabricVTON – Virtual Try-On app block.

  Renders only a button. The modal markup and all behaviour live in
  assets/fabricvton.js, which loads deferred and builds its DOM on first click,
  so a product page that nobody interacts with pays almost nothing for this app.
{% endcomment %}

{%- if block.settings.enabled -%}
  {{ 'fabricvton.css' | asset_url | stylesheet_tag }}

  <div class="fabricvton-widget" style="margin: 12px 0;">
    <button
      type="button"
      data-fabricvton-button
      data-shop="{{ shop.permanent_domain }}"
      data-backend-url="{{ routes.root_url | append: 'apps/fabricvton' }}"
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-image="{{ product.featured_image | image_url: width: 1024 }}"
      data-require-email="{{ block.settings.require_email }}"
      data-version="{{ 'now' | date: '%s' }}"
      style="
        background-color: {{ block.settings.button_color }};
        color: {{ block.settings.button_text_color }};
        border: none;
        border-radius: {{ block.settings.button_border_radius }};
        padding: 12px 24px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        max-width: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      "
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
      {{ block.settings.button_text | default: "Try It On" }}
    </button>
  </div>

  <script src="{{ 'fabricvton.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FabricVTON Try-On",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Virtual Try-On",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Try It On"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "default": "4px",
      "info": "e.g. 4px for sharp, 20px for pill shape"
    },
    {
      "type": "checkbox",
      "id": "require_email",
      "label": "Require Email Before Try-On",
      "default": true,
      "info": "Captures customer emails as marketing leads"
    }
  ]
}
{% endschema %}
