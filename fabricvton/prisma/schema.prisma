// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// Shopify OAuth session storage
// (required by @shopify/shopify-app-session-storage-prisma)
// ═══════════════════════════════════════════════════════════
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ═══════════════════════════════════════════════════════════
// Per-shop widget settings, billing, and configuration
// ═══════════════════════════════════════════════════════════
model ShopConfig {
  id                  String   @id @default(cuid())
  shop                String   @unique
  isEnabled           Boolean  @default(true)
  isSuspended         Boolean  @default(false) // Super admin can suspend a shop
  suspendReason       String?

  // Widget customization
  buttonText          String   @default("Try It On")
  buttonColor         String   @default("#000000")
  buttonTextColor     String   @default("#ffffff")
  buttonBorderRadius  String   @default("4px")
  requireEmailCapture Boolean  @default(true)

  // Billing
  // Internal plan key. "free" is the entry tier — surfaced to merchants as "Basic",
  // since Shopify does not allow "Free" as a plan name on App Store listings.
  plan                String   @default("free") // free | starter | growth | pro | scale
  billingId           String?  // Shopify recurring charge ID
  // Must match PLANS[free].credits in app/billing.server.ts
  monthlyCredits      Int      @default(15)

  // ── Custom plan (set by a super admin, for a store on a negotiated deal) ──
  // When customCredits is set it overrides the allowance the store's plan would
  // otherwise grant, and every billing sync leaves it alone. Payment for these
  // happens outside the plan picker — a Shopify private plan, an invoice, a
  // bank transfer — so customNote records what was agreed and by whom.
  customPlanLabel     String?
  customCredits       Int?
  customNote          String?
  customSetAt         DateTime?
  customSetBy         String?
  // Credits bought outright through a one-off invoice, on top of the plan's own
  // allowance. Cleared when the billing cycle rolls — a top-up is for the cycle
  // it was bought in, which is what the invoice says when it is drafted.
  cycleTopUpCredits   Int      @default(0)
  creditsUsed         Int      @default(0)
  billingCycleStart   DateTime @default(now())
  overageChargesTotal Float    @default(0) // Total overage billed this cycle in USD
  // USD of overage held by try-ons that have started but not yet settled. Kept
  // separate from overageChargesTotal so concurrent generations can never
  // reserve past the usage cap the merchant approved. See app/credits.server.ts.
  overageReserved     Float    @default(0)

  // Integrations
  klaviyoApiKey       String?
  klaviyoListId       String?

  // Model settings
  modelProvider       String   @default("youcam") // youcam | custom
  modelVersion        String   @default("cloth-v4")

  // ── Platform ──
  // Which storefront platform this tenant is. Shopify rows keep their
  // myshopify domain as `shop`; WooCommerce rows use an opaque `woo_<id>` key,
  // because a WordPress site's URL can change (domain moves, staging clones)
  // and must never be the identity.
  platform            String   @default("shopify") // shopify | woocommerce

  // ── WooCommerce connection (null for Shopify) ──
  // Public URL of the store, as reported by the plugin and verified by calling
  // it back. Used as the allowed CORS origin for shopper requests.
  siteUrl             String?
  // Per-store HMAC secret, AES-256-GCM encrypted with WOO_SECRET_ENCRYPTION_KEY.
  // Stored reversibly on purpose: verifying an HMAC needs the secret itself,
  // so a one-way hash would make every signature unverifiable.
  siteSecretEnc       String?
  // pending (registered, domain not yet proven) | connected | disconnected
  connectionStatus    String?
  siteVerifiedAt      DateTime?
  // Set on disconnect; the store's data is purged RETENTION.wooDisconnectedStoreDays
  // later unless the same site reconnects first.
  disconnectedAt      DateTime?
  pluginVersion       String?
  lastHeartbeatAt     DateTime?
  adminEmail          String?
  storeName           String?

  // Timestamps
  installedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([platform])
  @@index([siteUrl])
}

// ═══════════════════════════════════════════════════════════
// Razorpay subscriptions for WooCommerce stores
//
// Shopify stores are billed by Shopify; WooCommerce stores pay us directly.
// One row per Razorpay subscription we create. Razorpay is the source of
// truth: every webhook or checkout return re-fetches the subscription and
// mirrors it here (see app/woo/billing.server.ts), so events arriving late,
// twice or out of order can't leave a store on the wrong plan.
// ═══════════════════════════════════════════════════════════
model BillingSubscription {
  id               String    @id // Razorpay subscription id (sub_…)
  shop             String
  plan             String    // internal plan key: starter | growth | pro | scale
  interval         String    // monthly | annual
  providerPlanId   String    // Razorpay plan id (plan_…)
  amount           Int       // per billing period, in the currency's smallest unit
  currency         String
  // created | authenticated | active | pending | halted | cancelled | completed | expired | paused
  status           String    @default("created")
  // Opaque id in our hosted checkout page's URL, so the subscription id and
  // store id never appear in links.
  checkoutToken    String    @unique
  // WordPress admin page the merchant returns to after paying. Always on the
  // store's own origin (checked when the checkout is created).
  returnUrl        String
  // Set for a downgrade, which starts when the current plan's period ends.
  startAt          DateTime?
  // When the checkout return carried a valid Razorpay payment signature.
  // Razorpay can still report "created" for a moment after paying, so this
  // lets the plan switch at once instead of waiting for the webhook.
  paymentVerifiedAt DateTime?
  currentStart     DateTime?
  currentEnd       DateTime?
  cancelAtCycleEnd Boolean   @default(false)
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop])
}

// Our plans as Razorpay plan objects. Razorpay plans are immutable, so the key
// includes the price: changing a price in PLANS creates a new Razorpay plan for
// new subscriptions and leaves existing subscribers on the one they bought.
model BillingProviderPlan {
  key            String   @id // "<plan>:<interval>:<currency>:<amount>"
  providerPlanId String
  createdAt      DateTime @default(now())
}

// Razorpay webhook deliveries already handled, by event id. Razorpay retries a
// delivery until it gets a 2xx, so the same event can arrive more than once.
model BillingWebhookEvent {
  id         String   @id
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ═══════════════════════════════════════════════════════════
// Captured customer lead emails
// ═══════════════════════════════════════════════════════════
model Lead {
  id           String   @id @default(cuid())
  shop         String
  email        String
  productId    String?
  productTitle String?
  source       String   @default("tryon_widget")
  synced       Boolean  @default(false) // synced to Klaviyo?
  // What the shopper agreed to in the widget before any data was sent, and when.
  // DPDP Act 2023 s.6(10) puts the burden of proving consent on the fiduciary.
  consentVersion String?
  consentAt      DateTime?
  createdAt    DateTime @default(now())

  @@index([shop])
  @@index([email])
  @@index([shop, email])
}

// ═══════════════════════════════════════════════════════════
// Each individual virtual try-on event
// ═══════════════════════════════════════════════════════════
model TryOnEvent {
  id              String   @id @default(cuid())
  shop            String
  sessionId       String?
  productId       String?
  productTitle    String?
  leadEmail       String?
  status          String   @default("success") // pending | success | failed
  modelUsed       String   @default("youcam/cloth-v4")
  processingMs    Int?
  providerTaskId  String?  // YouCam task_id for polling
  errorCode       String?  // Provider error code, e.g. error_pose
  errorMessage    String?  // Store error details for debugging
  // Every `pending` event holds exactly one reserved credit, plus this many USD
  // of reserved overage (0 when the try-on fits inside the monthly allowance).
  // Settling the event either bills it or releases it — never both.
  overageAmount   Float    @default(0)
  // Consent the shopper gave before this photo was submitted (see Lead above).
  consentVersion  String?
  consentAt       DateTime?
  // What the shopper thought of the result: "up" or "down", from the widget's
  // one-tap rating. Null until they answer, which most never will.
  rating          String?
  ratedAt         DateTime?
  createdAt       DateTime @default(now())

  @@index([shop])
  @@index([createdAt])
  @@index([providerTaskId])
  @@index([shop, providerTaskId])
  @@index([shop, status])
}

// ═══════════════════════════════════════════════════════════
// Analytics aggregated per day per shop
// ═══════════════════════════════════════════════════════════
model AnalyticsDaily {
  id              String   @id @default(cuid())
  shop            String
  date            DateTime
  widgetOpens     Int      @default(0)
  emailsCaptured  Int      @default(0)
  tryOnsCompleted Int      @default(0)
  tryOnsFailed    Int      @default(0)

  @@unique([shop, date])
  @@index([shop])
}

// ═══════════════════════════════════════════════════════════
// Super Admin audit log — tracks every admin action
// ═══════════════════════════════════════════════════════════
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminShop   String   // Which super admin shop performed this
  action      String   // e.g. "suspend_shop", "change_plan", "change_model"
  targetShop  String?  // Which shop was affected
  details     String?  // JSON string with extra context
  createdAt   DateTime @default(now())

  @@index([adminShop])
  @@index([targetShop])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// Fixed-window rate limit counters
//
// One row per (scope, window). Incremented with a single atomic
// INSERT … ON CONFLICT DO UPDATE so the limit holds across app instances,
// which an in-process counter cannot do. See app/ratelimit.server.ts.
// ═══════════════════════════════════════════════════════════
model RateLimitWindow {
  id    String @id @default(cuid())
  scope String
  // Window start as epoch milliseconds, deliberately NOT a DateTime.
  //
  // This row is written by raw SQL (the atomic upsert) and read back by the
  // Prisma query builder (the purge). Those two disagree about how to interpret a
  // JS Date against `timestamp without time zone`: the raw path applies the
  // database session's timezone offset, the query builder treats it as UTC. On any
  // server not running in UTC that skews the purge comparison by the offset and
  // the counter table never gets cleaned up. An integer has no timezone to
  // disagree about.
  windowStartMs BigInt
  count         Int    @default(0)

  @@unique([scope, windowStartMs])
  @@index([windowStartMs])
}

// ═══════════════════════════════════════════════════════════
// GDPR/CCPA customer data requests (customers/data_request)
//
// The webhook compiles the shopper's stored data into exportJson at receipt
// time, so the record is a point-in-time snapshot even if the data is later
// redacted. The merchant then downloads it and marks it delivered, which is the
// auditable half of the workflow.
// ═══════════════════════════════════════════════════════════
model PrivacyRequest {
  id            String    @id @default(cuid())
  shop          String
  type          String    @default("customer_data_request")
  customerId    String?
  customerEmail String?
  orderIds      String?   // JSON array of order IDs Shopify included
  status        String    @default("pending") // pending | delivered | no_data
  exportJson    String?   // Compiled snapshot of everything we hold
  recordCount   Int       @default(0)
  requestedAt   DateTime  @default(now())
  deliveredAt   DateTime?
  deliveredTo   String?   // Where the merchant sent it
  deliveredBy   String?   // Which admin user marked it delivered
  note          String?

  @@index([shop])
  @@index([shop, status])
  @@index([requestedAt])
}

// Nonces of signed WooCommerce plugin requests, kept briefly so a captured
// request can't be replayed inside its timestamp window. The id is
// "<store>:<nonce>", so a second insert of the same pair fails on the key.
model WooRequestNonce {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// A try-on the shopper chose to share.
//
// This is the only place a generated image is ever kept, and only because the
// shopper asked for a link that outlives the provider's two-hour URL. It is
// deleted with its stored image after RETENTION.sharedLookDays.
// ═══════════════════════════════════════════════════════════
model SharedLook {
  id           String   @id // the short token in the /look/<id> URL
  shop         String
  // Provider task id, so a support request about one shared look can be traced.
  generationId String?
  imageKey     String   // object key in the share bucket
  contentType  String   @default("image/jpeg")
  productTitle String?
  productUrl   String?
  productImage String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@index([shop])
}

/// A one-off sale of credits: drafted by an admin, paid by the merchant through
/// Razorpay, and applied to the store's allowance for the current cycle.
///
/// Money and credits are deliberately separate columns: `amount` is what the
/// merchant agreed to pay in whatever currency was quoted, and `credits` is what
/// they get. Nothing derives one from the other, because these are negotiated
/// deals rather than a price list.
model CreditInvoice {
  id        String @id
  shop      String
  /// Try-ons granted when this is paid.
  credits   Int
  /// Charged amount in `currency` major units (₹29000.00, $349.00).
  amount    Float
  /// INR or USD — chosen per invoice, since stores are sold to in both.
  currency  String @default("INR")

  /// draft → sent → paid, or cancelled from either of the first two.
  /// Only `sent` invoices are visible to the merchant, and only `sent` ones can
  /// be paid, so a half-written draft can never be charged by accident.
  status    String @default("draft")

  /// What the merchant sees on the invoice, e.g. "Diwali top-up, agreed on call".
  description String?
  /// Internal only, never sent to the merchant.
  internalNote String?

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  /// Set the moment credits are granted, and checked before granting, so a
  /// retried webhook and a returning browser cannot both top the store up.
  creditsAppliedAt DateTime?

  createdBy   String
  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shop, status])
  @@index([status, createdAt])
}

/// A person who signs in to the platform.
///
/// Identity used to *be* a Shopify shop: if you were not a merchant with the app
/// installed, you did not exist. An account decouples the two — you sign in with
/// Google, and connecting a store becomes something you do, not something you
/// must do first. A merchant arriving from their Shopify admin still gets an
/// account; it is just created for them instead of by them.
model Account {
  id         String   @id
  /// Lower-cased. The natural key across sign-in methods, so a merchant who
  /// later signs in with Google lands on the account their store already made.
  email      String   @unique
  name       String?
  avatarUrl  String?
  /// Google's stable subject id. Kept separate from the email, which people change.
  googleSub  String?  @unique

  /// Credits held by the account itself, for the Playground and (later) API
  /// keys. A connected store's plan allowance is separate and stays on the store.
  credits    Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime?

  stores     AccountStore[]

  @@index([googleSub])
}

/// Links an account to a store it may manage.
///
/// Many-to-many on purpose: one person can run several stores, and one store can
/// be reachable by more than one person without either of them sharing a login.
model AccountStore {
  accountId String
  shop      String
  /// How this link came about: "shopify" (arrived from the store admin) or
  /// "manual" (connected from the platform). Useful when revoking.
  via       String   @default("shopify")
  linkedAt  DateTime @default(now())

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, shop])
  @@index([shop])
}
