/* Clothsy AI try-on widget for WooCommerce.
   Loaded once per product page; the modal markup itself is only built on first
   click, so nothing here paints until a shopper actually opens the widget.

   Everything is scoped under .clothsy-ai-* and sets its own values rather than
   inheriting, because this markup lands inside an unknown merchant theme. */

.clothsy-ai-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(18, 16, 30, 0.55);
  backdrop-filter: blur(6px);
  z-index: 9998;
}

.clothsy-ai-modal {
  --ca-ink: #14131a;
  --ca-muted: #6b6a76;
  --ca-line: #e9e7f1;
  --ca-soft: #f7f6fb;
  --ca-accent: #6c4fe0;
  --ca-accent-soft: #efecfd;

  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 22px;
  padding: 20px 24px 24px;
  width: 92%;
  max-width: 440px;
  z-index: 9999;
  box-shadow: 0 30px 70px rgba(20, 19, 26, 0.28);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
  color: var(--ca-ink);
  /* A tall result image on a short screen must not push the close button off
     the viewport — scroll inside the dialog instead. */
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
  line-height: 1.45;
}

@media (max-width: 480px) {
  .clothsy-ai-modal {
    top: auto;
    bottom: 0;
    left: 0;
    right: 0;
    transform: none;
    width: 100%;
    max-width: 100%;
    border-radius: 24px 24px 0 0;
    padding: 16px 18px max(20px, env(safe-area-inset-bottom, 18px));
    max-height: 92dvh;
  }
}

/* ── Header ─────────────────────────────────────────────── */

.clothsy-ai-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.clothsy-ai-brand {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ca-ink);
}

.clothsy-ai-brand i {
  font-style: normal;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 2px 6px;
  border-radius: 999px;
  color: var(--ca-accent);
  background: var(--ca-accent-soft);
}

.clothsy-ai-close {
  background: none;
  border: none;
  padding: 4px;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  color: var(--ca-muted);
  border-radius: 8px;
}
.clothsy-ai-close:hover { background: var(--ca-soft); color: var(--ca-ink); }

/* ── Steps ──────────────────────────────────────────────── */

.clothsy-ai-step { display: none; }
.clothsy-ai-step[data-active="true"] { display: block; }

.clothsy-ai-modal h2 {
  margin: 0 0 6px;
  font-size: 23px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ca-ink);
  text-align: center;
}

.clothsy-ai-lead {
  margin: 0 0 18px;
  color: var(--ca-muted);
  font-size: 14px;
  text-align: center;
}

/* ── Controls ───────────────────────────────────────────── */

.clothsy-ai-field {
  padding: 13px 16px;
  border: 1.5px solid var(--ca-line);
  border-radius: 12px;
  font-size: 15px;
  outline: none;
  transition: border-color 0.15s;
  width: 100%;
  box-sizing: border-box;
  font-family: inherit;
  color: var(--ca-ink);
  background: #fff;
}
.clothsy-ai-field:focus { border-color: var(--ca-accent); }

.clothsy-ai-primary,
.clothsy-ai-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  border: none;
  border-radius: 12px;
  padding: 14px;
  font-size: 15px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  box-sizing: border-box;
}

.clothsy-ai-primary { background: #17161d; color: #fff; }
.clothsy-ai-primary:hover { background: #000; }
.clothsy-ai-secondary { background: var(--ca-soft); color: var(--ca-ink); }
.clothsy-ai-secondary:hover { background: #efedf6; }

.clothsy-ai-primary[disabled],
.clothsy-ai-secondary[disabled] { opacity: 0.45; cursor: not-allowed; }

.clothsy-ai-primary svg,
.clothsy-ai-secondary svg { flex: none; }

.clothsy-ai-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ── Upload step ────────────────────────────────────────── */

.clothsy-ai-dropzone {
  border: 1.5px dashed #d6d2e8;
  border-radius: 16px;
  background: var(--ca-soft);
  padding: 30px 20px;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}
.clothsy-ai-dropzone:hover,
.clothsy-ai-dropzone.is-dragover {
  border-color: var(--ca-accent);
  background: var(--ca-accent-soft);
}
.clothsy-ai-dropzone svg { color: var(--ca-accent); margin-bottom: 8px; }
.clothsy-ai-dropzone b {
  display: block;
  font-size: 15px;
  font-weight: 600;
}
.clothsy-ai-dropzone span {
  display: block;
  margin-top: 3px;
  font-size: 12.5px;
  color: var(--ca-muted);
}

.clothsy-ai-or {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 14px 0;
  font-size: 12.5px;
  color: var(--ca-muted);
}
.clothsy-ai-or::before,
.clothsy-ai-or::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--ca-line);
}

.clothsy-ai-private {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 16px 0 0;
  font-size: 12.5px;
  color: var(--ca-muted);
}
.clothsy-ai-private svg { flex: none; }

/* ── Confirm step ───────────────────────────────────────── */

.clothsy-ai-photo {
  display: block;
  width: 100%;
  max-height: 46vh;
  object-fit: contain;
  border-radius: 16px;
  background: var(--ca-soft);
  margin-bottom: 14px;
}

.clothsy-ai-consent {
  border: 1px solid var(--ca-line);
  border-radius: 14px;
  background: var(--ca-soft);
  padding: 12px 14px;
  margin-bottom: 12px;
}

.clothsy-ai-consent-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px;
  cursor: pointer;
  color: var(--ca-ink);
}

.clothsy-ai-consent-row input {
  flex: none;
  width: 17px;
  height: 17px;
  margin: 1px 0 0;
  accent-color: var(--ca-accent);
  cursor: pointer;
}

.clothsy-ai-consent-note {
  margin: 8px 0 0;
  font-size: 11.5px;
  line-height: 1.5;
  color: var(--ca-muted);
}
.clothsy-ai-consent-note a { color: var(--ca-accent); }

/* ── Generating step ────────────────────────────────────── */

.clothsy-ai-loading { text-align: center; }

.clothsy-ai-ring {
  display: block;
  margin: 18px auto 16px;
  width: 104px;
  height: 104px;
}
.clothsy-ai-ring circle { fill: none; stroke-width: 6; stroke-linecap: round; }
.clothsy-ai-ring .ca-track { stroke: var(--ca-accent-soft); }
.clothsy-ai-ring .ca-arc {
  stroke: var(--ca-accent);
  transform-origin: 50% 50%;
  transform: rotate(-90deg);
  transition: stroke-dashoffset 0.6s ease;
  animation: clothsy-ai-sweep 1.4s linear infinite;
}

@keyframes clothsy-ai-sweep {
  to { transform: rotate(270deg); }
}

@media (prefers-reduced-motion: reduce) {
  .clothsy-ai-ring .ca-arc { animation: none; }
}

.clothsy-ai-steps {
  list-style: none;
  margin: 0 auto;
  padding: 0;
  max-width: 250px;
  text-align: left;
}
.clothsy-ai-steps li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 0;
  font-size: 13.5px;
  color: var(--ca-muted);
}
.clothsy-ai-steps li b {
  flex: none;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  border: 1.5px solid var(--ca-line);
  background: #fff;
}
.clothsy-ai-steps li[data-state="active"] { color: var(--ca-ink); font-weight: 600; }
.clothsy-ai-steps li[data-state="active"] b {
  border-color: var(--ca-accent);
  background: var(--ca-accent-soft);
}
.clothsy-ai-steps li[data-state="done"] { color: var(--ca-ink); }
.clothsy-ai-steps li[data-state="done"] b {
  border-color: var(--ca-accent);
  background: var(--ca-accent) url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none' stroke='%23fff' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M3.5 8.5l3 3 6-7'/%3E%3C/svg%3E") center / 13px no-repeat;
}

.clothsy-ai-almost {
  margin: 14px 0 0;
  font-size: 12.5px;
  color: var(--ca-muted);
}

/* ── Result step ────────────────────────────────────────── */

.clothsy-ai-result-img {
  display: block;
  width: 100%;
  max-height: 54vh;
  object-fit: contain;
  border-radius: 16px;
  background: var(--ca-soft);
}

/* Compare: the original sits underneath and the try-on is clipped over it, so
   dragging the handle wipes between the two without reloading either image. */
.clothsy-ai-compare {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: var(--ca-soft);
  touch-action: none;
}
.clothsy-ai-compare img {
  display: block;
  width: 100%;
  max-height: 54vh;
  object-fit: contain;
}
.clothsy-ai-compare-top {
  position: absolute;
  inset: 0;
  overflow: hidden;
  width: 50%;
}
/* The overlay is clipped, so its image must keep the full box width (set from
   JS) — sizing it to the clip would squash the try-on as the handle moves. */
.clothsy-ai-compare-top img {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  max-width: none;
  object-fit: contain;
}
.clothsy-ai-compare-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #fff;
  box-shadow: 0 0 0 1px rgba(20, 19, 26, 0.12);
  pointer-events: none;
}
.clothsy-ai-compare-grip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4px 14px rgba(20, 19, 26, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ca-ink);
}
.clothsy-ai-compare-range {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  cursor: ew-resize;
}
.clothsy-ai-tag {
  position: absolute;
  bottom: 10px;
  padding: 4px 9px;
  border-radius: 999px;
  background: rgba(20, 19, 26, 0.72);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  pointer-events: none;
}
.clothsy-ai-tag-before { left: 10px; }
.clothsy-ai-tag-after { right: 10px; }

.clothsy-ai-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}
/* Side by side these are narrow; a wrapped "Add to / cart" looks broken. */
.clothsy-ai-actions .clothsy-ai-primary,
.clothsy-ai-actions .clothsy-ai-secondary {
  flex: 1;
  width: auto;
  white-space: nowrap;
  padding: 14px 12px;
}

.clothsy-ai-toggle {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin: 12px auto 0;
  padding: 8px 14px;
  border: 1px solid var(--ca-line);
  border-radius: 999px;
  background: #fff;
  color: var(--ca-ink);
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
}
.clothsy-ai-toggle:hover { background: var(--ca-soft); }
.clothsy-ai-toggle[aria-pressed="true"] {
  border-color: var(--ca-accent);
  color: var(--ca-accent);
  background: var(--ca-accent-soft);
}
.clothsy-ai-center { display: flex; justify-content: center; }

.clothsy-ai-disclaimer {
  margin: 12px 0 0;
  font-size: 11.5px;
  color: var(--ca-muted);
  text-align: center;
}

/* ── Done step ──────────────────────────────────────────── */

.clothsy-ai-done { text-align: center; padding: 8px 0 0; }
.clothsy-ai-done-mark {
  width: 64px;
  height: 64px;
  margin: 6px auto 16px;
  border-radius: 50%;
  background: var(--ca-accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Error step ─────────────────────────────────────────── */

.clothsy-ai-error { text-align: center; padding: 8px 0 0; }
.clothsy-ai-error-icon { font-size: 34px; margin: 0 0 8px; }
.clothsy-ai-error-msg {
  margin: 0 0 16px;
  font-size: 14px;
  color: var(--ca-muted);
}

.clothsy-ai-visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
