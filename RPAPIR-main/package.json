{
  "name": "secure-api-key-pool",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc --noEmit && node scripts/build-lambda.mjs",
    "import:keys": "node --env-file-if-exists=.env --import tsx scripts/import-keys.ts",
    "import:grouped": "node --env-file-if-exists=.env --import tsx scripts/import-grouped-keys.ts",
    "verify:grouped": "node --env-file-if-exists=.env --import tsx scripts/verify-grouped-keys.ts",
    "create:client": "node --env-file-if-exists=.env --import tsx scripts/create-client.ts",
    "keys:list": "node --env-file-if-exists=.env --import tsx scripts/manage-key.ts list",
    "keys:disable": "node --env-file-if-exists=.env --import tsx scripts/manage-key.ts disable",
    "keys:enable": "node --env-file-if-exists=.env --import tsx scripts/manage-key.ts enable",
    "sheet:sync": "node --env-file-if-exists=.env --import tsx scripts/sheet-sync.ts",
    "sheet:check": "node --env-file-if-exists=.env --import tsx scripts/sheet-sync.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.888.0",
    "@aws-sdk/client-secrets-manager": "^3.888.0",
    "@aws-sdk/lib-dynamodb": "^3.888.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "esbuild": "^0.25.0"
  }
}
