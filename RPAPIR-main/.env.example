# Local operator configuration only. Do NOT put upstream API values here.
AWS_REGION=us-east-1
KEY_SECRET_PREFIX=api-key-pool/providers
DDB_TABLE_NAME=api-key-pool-keys
CLIENT_TABLE_NAME=api-key-pool-clients

# Provider configuration. URL is fixed server-side; clients cannot choose it.
UPSTREAM_BASE_URL=https://api.example.com
UPSTREAM_PATH=/v1/request
PROVIDER_NAME=provider-x

# Runtime limits
UPSTREAM_TIMEOUT_MS=12000
MAX_UPSTREAM_ATTEMPTS=4
MAX_REQUEST_BODY_BYTES=262144
MAX_UPSTREAM_RESPONSE_BYTES=1048576
KEY_CANDIDATE_LIMIT=50
LEASE_SECONDS=30
TEMP_DISABLE_SECONDS=60
PERMANENT_DISABLE_AFTER_AUTH=true

# Optional customer-managed KMS key used by Secrets Manager.
# Populate from: terraform -chdir=terraform output -raw secrets_kms_key_arn
SECRETS_KMS_KEY_ARN=

# App-layer credential is defense-in-depth. For the strongest B2B setup, also enable API Gateway mTLS.
REQUIRE_CLIENT_TOKEN=true
